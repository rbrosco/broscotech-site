# Copie para .env.local e preencha os valores. Nenhum destes valores é real.

# --- Banco de dados (obrigatório) ---
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# --- Autenticação (obrigatório em produção) ---
# Gere uma string aleatória longa, ex: openssl rand -base64 48
JWT_SECRET=

# --- IA Agent (chat com cliente) — pelo menos um provedor abaixo ---
# Sem isso configurado no servidor, o chat só funciona se o admin colar
# a própria chave em Configurações > IA Agent no navegador dele (fica
# salva só naquele navegador, não serve para os clientes).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Só se usar um modelo local via LM Studio:
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=

# --- Faturamento automático via Asaas (opcional) ---
# Sem isso, a criação de fatura continua funcionando com link colado
# manualmente pelo admin (comportamento anterior, sem quebrar nada).
# Com isso configurado E o CPF/CNPJ do cliente preenchido no formulário,
# a cobrança (Pix/boleto/cartão) é gerada automaticamente.
ASAAS_API_KEY=
# 'sandbox' (padrão, para testar sem operação financeira real) ou 'production'
ASAAS_ENV=sandbox

# --- WhatsApp via Evolution API (opcional) ---
# Sem isso, as atualizações de projeto continuam funcionando normalmente,
# só não saem notificações por WhatsApp (comportamento "silencioso").
# URL base da sua instância Evolution (self-hosted), ex: https://evolution.seudominio.com
EVOLUTION_API_URL=
# API key global da Evolution (header apikey)
EVOLUTION_API_KEY=
# Nomes exatos das instâncias já criadas na Evolution, separados por vírgula
# (uma por dev). Ex: EVOLUTION_INSTANCES=roger,outro-dev
EVOLUTION_INSTANCES=
# Instância usada quando o projeto não tem assigned_dev definido.
# Se vazio, usa a primeira de EVOLUTION_INSTANCES.
EVOLUTION_DEFAULT_INSTANCE=

